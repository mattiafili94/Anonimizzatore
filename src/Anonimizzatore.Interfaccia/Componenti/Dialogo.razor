@* Finestra di dialogo (Dialog): chiede una conferma o un dato. Escape annulla. Il focus parte dalla finestra. *@
<div class="dialogo-velo" @onclick="Chiudi">
    <div class="dialogo" role="dialog" aria-modal="true" aria-labelledby="@_idTitolo" tabindex="-1" @ref="_radice"
         @onclick:stopPropagation="true" @onkeydown="Tasto">
        <h2 class="type-section-heading" id="@_idTitolo">@Titolo</h2>
        <div>@ChildContent</div>
        <div class="dialogo-azioni">@Azioni</div>
    </div>
</div>

@code {
    private readonly string _idTitolo = "dialogo-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _radice;

    [Parameter, EditorRequired] public string Titolo { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Azioni { get; set; }

    /// <summary>Chiamato con Escape o con un clic fuori dalla finestra: deve chiudere senza fare altro.</summary>
    [Parameter] public EventCallback AlChiudere { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _radice.FocusAsync();
    }

    private Task Chiudi() => AlChiudere.InvokeAsync();

    private Task Tasto(KeyboardEventArgs e) => e.Key == "Escape" ? Chiudi() : Task.CompletedTask;
}
